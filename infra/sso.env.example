# GitLab SSO(oauth2-proxy) 비밀값. /opt/kkakkung/sso.env (600 root) 로 설치합니다. 값은 여기 쓰지 않습니다.
# GitLab: 프로필 → Preferences → Applications → kkakkung-sso (Redirect https://j15c204.p.ssafy.io/oauth2/callback,
# Confidential, scopes openid profile email read_api)
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
# 32바이트 무작위 (서버에서 생성: openssl rand -base64 32)
OAUTH2_PROXY_COOKIE_SECRET=
