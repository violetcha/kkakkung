# EC2 운영 비밀값 파일의 토대. 실제 파일은 이 예시를 복사해 값을 채운 뒤
# Jenkins 크리덴셜(Kind: Secret file, ID: kkakkung-production-env)로 올립니다.
# 배포 때 Jenkins 가 /opt/kkakkung/production.env (600, jenkins) 로 내려주고
# infra/compose.production.yaml 의 env_file 이 game-server 에만 읽힙니다.
#
# 규칙
# - 이 예시 파일에는 값을 쓰지 않는다. 실제 파일은 레포·채팅·MR 에 올리지 않는다.
# - 비밀이 아닌 설정(NODE_ENV, ALLOWED_ORIGINS, PORT 등)은 compose.production.yaml 에 있고
#   이 파일보다 우선한다. 여기엔 비밀값과 운영자 정책값만.
# - 그룹은 전부 있거나 전부 없어야 한다 (server/src/config/env.ts). 빈 값(KEY=)은 미설정과 같다.
# - 값을 바꾸면 Jenkins 크리덴셜을 갱신하고 develop 재배포 또는 infra/deploy.sh 로 반영.

# --- LiveKit Cloud (E-05 / MC-02). 4개 세트 ---
LIVEKIT_HTTP_URL=
LIVEKIT_WS_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_PROJECT_ALIAS=

# --- 격리된 실제 시험 namespace. Compose와 Cloud preflight가 같은 값을 사용 ---
SERVICE_NAMESPACE=

# --- 운영 API (E OP-07). 세션 Bearer 와 별개. 길고 무작위한 값 ---
OPS_TOKEN=

# --- 운영 정책 (E operations). 운영자가 정한 실제 값만. 임의 기본값 금지 ---
# 제품 배포 기본값 continuous: 서비스 종료 날짜/대시보드 확인 시각의 수동 갱신 없음.
OPS_OPERATING_MODE=continuous
# 아래 세 값은 기존 attested 시험 모드에서만 필요하다.
OPS_PUBLIC_WINDOW_OPENS_AT_EPOCH_MS=
OPS_PUBLIC_WINDOW_CLOSES_AT_EPOCH_MS=
OPS_OFFICIAL_BUDGET_MAX_AGE_MS=
# 두 모드에서 필요한 운영/API 상한
OPS_OPERATION_TIMEOUT_MS=
MEDIA_MAX_NORMAL_API_CALLS_PER_60S=
MEDIA_MAX_TOTAL_API_CALLS_PER_60S=

# --- 초대·입장 정책 (B AC-01/02). 5개 세트, 미설정이면 제품 admission LOCKED ---
INVITE_MAX_TTL_MS=
SESSION_ATTEMPT_WINDOW_MS=
SESSION_ATTEMPTS_PER_INVITE=
SESSION_ATTEMPTS_PER_IP=
ROOM_IDLE_TTL_MS=

# Jenkins-only internal smoke authentication. Generate a random 32-byte hex key.
# These values are consumed by deployment scripts, not by the game container/browser.
SMOKE_INTERNAL_BASE_URL=http://127.0.0.1:18081
SMOKE_INTERNAL_TOKEN=
