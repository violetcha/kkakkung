NODE_ENV=development
SERVER_PROFILE=development
TRUST_PROXY_HOPS=0
# invitation by default. gitlab-sso requires product + TRUST_PROXY_HOPS=1, private ingress,
# and host auth_request replacing X-SSO-User. Never enable behind a public server port.
SESSION_ADMISSION_MODE=invitation
PRODUCT_ASSET_VERSION=c-primitives-1
PRODUCT_CONTENT_DIR=server/content
PRODUCT_TUNING_PATH=server/config/tuning/mvp-v1.json
# maze-v1 (corridor width 1, default) or master-v1 (open grid). Both ship a certified fallback.
PRODUCT_MAP_TEMPLATE=maze-v1
HOST=127.0.0.1
PORT=2567
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:2567,http://127.0.0.1:2567
SERVICE_NAMESPACE=kkakkung-local
MEDIA_MODE=disabled
# Internal trusted six-person test only; requires matching real Cloud evidence.
MEDIA_SUBSCRIPTION_MODE=server-controlled
OPS_DATA_DIR=./.local/operations
MAX_ROOMS=1
MAX_SLOTS=6
LOG_LEVEL=info

# Optional groups (server/src/config/env.ts, owner F). A group is all-or-nothing; an empty
# value is treated as unset, so keep unused lines commented out. Real values live only in the runtime
# environment (Jenkins credentials -> env file), never in this file or in the image.
# LIVEKIT_HTTP_URL=
# LIVEKIT_WS_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_PROJECT_ALIAS=
# OPS_TOKEN=
# 관리자 시연용 데모 방(S15P21C204-258). OPS_TOKEN 이 있을 때만 1 로 켤 수 있고 운영은 0 이다.
# DEMO_ROOMS=0
# OPS_PUBLIC_WINDOW_OPENS_AT_EPOCH_MS=
# OPS_PUBLIC_WINDOW_CLOSES_AT_EPOCH_MS=
# OPS_OFFICIAL_BUDGET_MAX_AGE_MS=
# OPS_OPERATION_TIMEOUT_MS=
# MEDIA_MAX_NORMAL_API_CALLS_PER_60S=600
# MEDIA_MAX_TOTAL_API_CALLS_PER_60S=900
# INVITE_MAX_TTL_MS=
# SESSION_ATTEMPT_WINDOW_MS=
# SESSION_ATTEMPTS_PER_INVITE=
# SESSION_ATTEMPTS_PER_IP=
# ROOM_IDLE_TTL_MS=

# SERVER_PROFILE=product selects the real game assembly; an explicit complete admission
# policy above is required. MEDIA_MODE=disabled keeps media and product admission LOCKED.
# MEDIA_MODE=livekit additionally requires the complete LiveKit group, project alias,
# operator token, timeout and API limits. The legacy attested mode also requires public window and official budget age.
# OPS_OPERATING_MODE=continuous uses persistent service-operations.json and provider quota; see docs/operations.md.
# E checks durable capability/accounting/recovery
# NODE_ENV=production remains rejected until the deployment verification gate is accepted.
