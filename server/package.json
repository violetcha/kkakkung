{
  "name": "@kkakkung/game-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    ".env.example"
  ],
  "scripts": {
    "dev": "tsx watch --include ../packages/**/dist/** src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "serve": "node dist/index.js",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@kkakkung/protocol": "workspace:*",
    "@kkakkung/game-core": "workspace:*",
    "@colyseus/core": "0.18.11",
    "@colyseus/ws-transport": "0.18.2",
    "express": "5.2.1",
    "cors": "2.8.6",
    "livekit-server-sdk": "2.18.0",
    "pino": "10.3.1",
    "zod": "4.5.4",
    "@colyseus/monitor": "0.18.3",
    "@colyseus/playground": "0.18.4",
    "@colyseus/schema": "5.0.27"
  },
  "devDependencies": {
    "@colyseus/testing": "0.18.5",
    "@colyseus/tools": "0.18.3",
    "@colyseus/sdk": "0.18.2",
    "@types/express": "5.0.6",
    "@types/cors": "2.8.19"
  }
}
