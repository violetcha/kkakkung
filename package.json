{
  "name": "kkakkung",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "setup:env": "node scripts/setup-env.mjs",
    "build:packages": "tsc -b tsconfig.packages.json",
    "build": "pnpm build:packages && pnpm --filter @kkakkung/game-server build && pnpm --filter @kkakkung/web build",
    "dev": "node scripts/dev.mjs",
    "dev:web": "node scripts/dev.mjs web",
    "dev:server": "node scripts/dev.mjs server",
    "typecheck": "pnpm build:packages && pnpm -r typecheck && tsc -p tsconfig.qa.json --noEmit",
    "lint": "eslint . && node scripts/check-boundaries.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build:packages && vitest run",
    "test:maps": "pnpm build:packages && vitest run packages/game-core/test/match/certified-maps.test.ts packages/game-core/test/match/maze-template.test.ts",
    "maps:generate": "pnpm build:packages && node scripts/generate-maze-template.mjs",
    "maps:check": "pnpm build:packages && node scripts/generate-maze-template.mjs --check",
    "avatars:build": "node scripts/build-avatar-assets.mjs",
    "avatars:check": "node scripts/build-avatar-assets.mjs --check",
    "test:e2e": "pnpm build:packages && playwright test",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:product-assets && pnpm test:e2e",
    "check:product-assets": "node scripts/check-product-assets.mjs",
    "check:environment": "node scripts/check-execution-environment.mjs",
    "cloud:check": "node scripts/run-cloud-check.mjs",
    "probe:build": "vite build --config tests/cloud/vite.config.ts",
    "probe:dev": "vite --config tests/cloud/vite.config.ts",
    "livekit:token": "node scripts/livekit-token.mjs",
    "deploy:smoke": "node scripts/deployment-smoke.mjs"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.18.2",
    "@eslint/js": "10.0.1",
    "@kkakkung/game-core": "workspace:*",
    "@kkakkung/protocol": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "eslint": "10.10.0",
    "livekit-client": "2.22.2",
    "livekit-server-sdk": "2.18.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "ws": "8.21.3"
  }
}
