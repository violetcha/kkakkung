{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true
  },
  "include": ["tests/**/*.ts", "server/test/media/**/*.cloud.test.ts"],
  "exclude": ["tests/e2e/**"]
}
